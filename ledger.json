{
 "default_name": "full",
 "axes": [
  {
   "name": "shared",
   "meaning": "which weights the modules draw from a bank instead of owning: none, feed-forward, attention or both",
   "default": "none",
   "values": [["none", "own"], ["ff", "ff"], ["attn", "attn"], ["both", "both"]]
  },
  {
   "name": "pick",
   "meaning": "how a module gets its chunk: fixed is module i to chunk i mod N; routed is a per-token learned pick sampled with noise; argmax the same without noise; keys scores a learned key per chunk; frozen is routed until a quarter of training, then each module keeps its most common pick; stopped is routed with the router's weights held still after that quarter",
   "default": "fixed",
   "values": [
    ["fixed", "fixed"],
    ["routed", "routed"],
    ["argmax", "routed-argmax"],
    ["keys", "routed-keys"],
    ["frozen", "frozen-picks"],
    ["stopped", "stopped-router"]
   ]
  },
  {
   "name": "chunks",
   "meaning": "bank size: chunks stored per shared kind",
   "default": 4,
   "values": [[1, "c1"], [2, "c2"], [4, "c4"], [8, "c8"]]
  },
  {
   "name": "rank",
   "meaning": "rank of a low-rank correction each module adds to the shared chunk it uses; 0 is none",
   "default": 0,
   "values": [[0, "r0"], [24, "r24"]]
  },
  {
   "name": "modules",
   "meaning": "compute modules (layers)",
   "default": 8,
   "values": [[1, "plain-l1"], [2, "plain-l2"], [4, "plain-l4"], [6, "plain-l6"], [8, "plain-l8"]]
  },
  {
   "name": "width",
   "meaning": "hidden width",
   "default": 256,
   "values": [
    [96, "plain-w96"],
    [128, "plain-w128"],
    [160, "plain-w160"],
    [192, "plain-w192"],
    [224, "plain-w224"],
    [256, "plain-w256"]
   ]
  },
  {
   "name": "steps",
   "meaning": "training budget in optimizer steps; the tag is the directory under runs/",
   "default": 8000,
   "values": [[8000, "8000"], [32000, "32000"], [128000, "128000"]]
  },
  {
   "name": "architecture",
   "meaning": "the transformer around the banks: classic is learned positions, layer norms and a GELU feed-forward; modern is rotary positions, root-mean-square norms and a gated feed-forward",
   "default": "classic",
   "values": [["classic", "classic"], ["modern", "modern"]]
  }
 ],
 "hypotheses": [
  {
   "id": "low-rank-correction",
   "priority": 1,
   "status": "open",
   "statement": "A shared bank plus a low-rank correction per module beats plain sharing at equal stored weights: one chunk per bank with a rank-24 correction in each of the 8 modules reaches a lower loss than the fixed map with two chunks, which stores 2,304 more weights (0.1%).",
   "settle": [
    {
     "lower": {"shared": "both", "chunks": 1, "rank": 24, "steps": 32000},
     "higher": {"shared": "both", "chunks": 2, "steps": 32000}
    }
   ]
  },
  {
   "id": "reuse-survives-the-modern-architecture",
   "priority": 2,
   "status": "open",
   "statement": "The gain from reuse survives the modern architecture: with rotary positions, root-mean-square norms and a gated feed-forward, eight modules reusing four chunks still beat the plain model of four modules.",
   "settle": [
    {
     "lower": {"shared": "both", "steps": 32000, "architecture": "modern"},
     "higher": {"modules": 4, "steps": 32000, "architecture": "modern"}
    }
   ]
  },
  {
   "id": "picking-lock-in",
   "priority": 3,
   "status": "open",
   "statement": "A per-input pick loses to the fixed map because routers lock in early, near-random picks: with each module frozen to its router's most common pick after a quarter of training, the model still loses to the fixed map of module i to chunk i mod N.",
   "settle": [
    {
     "lower": {"shared": "both", "steps": 32000},
     "higher": {"shared": "both", "pick": "frozen", "steps": 32000}
    }
   ]
  },
  {
   "id": "picking-chase",
   "priority": 3,
   "status": "open",
   "statement": "A per-input pick loses because chunks and router chase each other: holding the router's weights still after a quarter of training beats letting it learn throughout.",
   "settle": [
    {
     "lower": {"shared": "both", "pick": "stopped", "steps": 32000},
     "higher": {"shared": "both", "pick": "routed", "steps": 32000}
    }
   ]
  },
  {
   "id": "picking-worse-function",
   "priority": 3,
   "status": "open",
   "statement": "A per-input pick loses because mixing chunks token by token is a worse function than one chunk per module, even under a router that no longer moves: frozen picks beat a stopped router.",
   "settle": [
    {
     "lower": {"shared": "both", "pick": "frozen", "steps": 32000},
     "higher": {"shared": "both", "pick": "stopped", "steps": 32000}
    }
   ]
  },
  {
   "id": "picking-too-few-steps",
   "priority": 4,
   "status": "open",
   "statement": "A per-input pick loses only because training is short: at 128,000 steps the routed model reaches a lower loss than the fixed map.",
   "settle": [
    {
     "lower": {"shared": "both", "pick": "routed", "steps": 128000},
     "higher": {"shared": "both", "steps": 128000}
    }
   ]
  },
  {
   "id": "compress-a-trained-model",
   "priority": 5,
   "status": "open",
   "statement": "A trained unshared model can be compressed into a shared bank and keep a lower loss than the same shared model trained from scratch. No cell expresses this yet: it needs an axis for how training starts.",
   "settle": []
  },
  {
   "id": "reuse-beats-fewer-modules",
   "priority": 9,
   "status": "supported",
   "statement": "Eight modules reusing N chunks beat the plain model of N modules, which stores the same chunks and applies each once.",
   "settle": [
    {
     "lower": {"shared": "both", "chunks": 1, "steps": 32000},
     "higher": {"modules": 1, "steps": 32000},
     "differences": [-0.258, -0.2593, -0.2622]
    },
    {
     "lower": {"shared": "both", "chunks": 2, "steps": 32000},
     "higher": {"modules": 2, "steps": 32000},
     "differences": [-0.0634, -0.0611, -0.0555]
    },
    {
     "lower": {"shared": "both", "steps": 32000},
     "higher": {"modules": 4, "steps": 32000},
     "differences": [-0.0195, -0.0198, -0.0164]
    }
   ]
  },
  {
   "id": "routing-beats-the-fixed-map",
   "priority": 9,
   "status": "refuted",
   "statement": "A per-input pick over the two banks beats the fixed map over the same banks.",
   "settle": [
    {
     "lower": {"shared": "both", "pick": "routed", "steps": 32000},
     "higher": {"shared": "both", "steps": 32000},
     "differences": [0.0194, 0.02, 0.0167]
    },
    {
     "lower": {"shared": "both", "pick": "argmax", "steps": 32000},
     "higher": {"shared": "both", "steps": 32000},
     "differences": [0.0361, 0.031, 0.0304]
    },
    {
     "lower": {"shared": "both", "pick": "keys", "steps": 32000},
     "higher": {"shared": "both", "steps": 32000},
     "differences": [0.0224, 0.0168, 0.0167]
    }
   ]
  }
 ],
